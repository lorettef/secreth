# Copy to .env on the VPS, replace every placeholder, and chmod 600 .env.
BOT_TOKEN=replace-with-botfather-token
POSTGRES_DB=ministry
POSTGRES_USER=ministry
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password below.
DATABASE_URL=postgresql+asyncpg://ministry:replace-with-a-long-random-password@db:5432/ministry

MINI_APP_DOMAIN=mini.example.org
MINI_APP_URL=https://mini.example.org
# Frontend and API share one HTTPS origin, so CORS stays disabled.
MINI_APP_ALLOWED_ORIGINS=[]

LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Yakutsk
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=30
